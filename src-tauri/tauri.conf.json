{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velox",
  "version": "0.1.0",
  "identifier": "com.kyrion.velox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velox",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Clean up and transcode video files with ffmpeg",
    "longDescription": "Velox remuxes and transcodes video files with ffmpeg: stream cleanup, audio standardisation, hardware video encoding and a size check.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
